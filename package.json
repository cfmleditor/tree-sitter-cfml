{
  "name": "@cfmleditor/tree-sitter-cfml",
  "version": "0.26.31",
  "description": "CFML grammar for tree-sitter",
  "repository": "github:cfmleditor/tree-sitter-cfml",
  "license": "MIT",
  "main": "bindings/node",
  "types": "bindings/node",
  "author": {
    "name": "garetheddies"
  },
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "cfml"
  ],
  "files": [
    "binding.gyp",
    "scripts/**",
    "prebuilds/**",
    "bindings/node/*",
    "cfml/grammar.js",
    "cfml/queries/*",
    "cfml/src/**",
    "cfscript/grammar.js",
    "cfscript/queries/*",
    "cfscript/src/**",
    "cfquery/grammar.js",
    "cfquery/queries/*",
    "cfquery/src/**",
    "common/define-grammar.js"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.1",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "eslint-config-treesitter": "^1.0.2",
    "globals": "^17.8.0",
    "prebuildify": "^6.0.1",
    "tree-sitter": "0.25.1",
    "tree-sitter-cli": "0.26.11"
  },
  "overrides": {
    "eslint-plugin-jsdoc": "^62.9.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18 <=24"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:native": "node scripts/build-native.js",
    "parse": "node scripts/parse.js",
    "scan": "node scripts/scan.js",
    "scan:examples": "node scripts/scan.js examples --isolate --expect examples/expected.json",
    "probe": "node scripts/probe.js",
    "bench": "node scripts/bench.js",
    "fuzz": "node scripts/fuzz.js",
    "corpus:fetch": "node scripts/fetch-corpus.js",
    "corpus:report": "node scripts/corpus-report.js",
    "test": "node scripts/test.js",
    "test:update": "node scripts/test.js --update",
    "docswasm": "node scripts/docswasm.js",
    "install": "node-gyp-build",
    "postinstall": "node scripts/ensure-tree-sitter-cli-binary.js",
    "prestart": "node scripts/prestart-wasm.js",
    "start": "node scripts/start-playground.js",
    "playground": "node scripts/playground.js",
    "testbindings": "node --test bindings/node/*_test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "node scripts/release.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "tree-sitter@0.25.1": true,
    "tree-sitter-cli@0.26.11": true
  }
}
